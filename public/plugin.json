{
  "name": "xml-format",
  "pluginName": "XML 格式化",
  "description": "XML 格式化、压缩、折叠、搜索与 JSON 双向互转工具",
  "author": "lijunxiang01",
  "homepage": "https://github.com/2952434/xml-formatting",
  "version": "1.0.0",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo1.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "xml-format",
      "explain": "XML 格式化、折叠和搜索工具",
      "cmds": [
        "xml",
        "XML 格式化",
        "xml格式化",
        "格式化xml"
      ]
    },
    {
      "code": "xml-format-file",
      "explain": "格式化选中的 XML 文件",
      "cmds": [
        {
          "type": "files",
          "label": "格式化 XML 文件",
          "fileType": "file",
          "match": "/\\.(xml|xsd|xsl|xslt|svg|rss|plist)$/i",
          "minLength": 1,
          "maxLength": 20
        }
      ]
    }
  ]
}
